# Environment Variables Template
# Copy this to .env and fill in your private API tokens.
# IMPORTANT: Do NOT add the VITE_ prefix to these keys.

# GitHub Personal Access Token (Repo scope required)
GITHUB_TOKEN=

# Vercel API Token (Settings > Tokens)
VERCEL_API_TOKEN=

# Vercel Team ID (Optional, found in Team Settings)
VERCEL_TEAM_ID=
